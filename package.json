{
  "name": "@huanf/echo",
  "version": "0.1.1",
  "description": "Local evidence-only Markdown retrieval MCP",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "markdown",
    "knowledge-base",
    "retrieval",
    "hybrid-search",
    "bm25",
    "vector-search",
    "sqlite"
  ],
  "type": "module",
  "bin": {
    "echo-mcp": "dist/cli.js"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-builtin-strategies.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:paths && npm run format:check && npm run typecheck && npm test && npm run smoke:default",
    "eval": "npm run build && node dist/eval-cli.js",
    "eval:retrieval": "npm run build && node dist/retrieval-eval-cli.js",
    "eval:compare": "npm run build && node dist/retrieval-compare-cli.js",
    "smoke:default": "node scripts/verify-default-runtime.mjs",
    "check:paths": "node scripts/check-public-paths.mjs",
    "prepack": "node scripts/clean-package-dist.mjs && npm run build",
    "smoke:package": "node scripts/verify-package-install.mjs",
    "prepublishOnly": "npm run check && npm run smoke:package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "13.0.3",
    "minisearch": "7.2.0",
    "sqlite-vec": "0.1.9",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.4",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "license": "MIT",
  "author": "huanf",
  "repository": {
    "type": "git",
    "url": "https://github.com/HuanHuanHuanFFF/Echo.git"
  },
  "homepage": "https://github.com/HuanHuanHuanFFF/Echo#readme",
  "bugs": {
    "url": "https://github.com/HuanHuanHuanFFF/Echo/issues"
  },
  "files": [
    "dist/",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
