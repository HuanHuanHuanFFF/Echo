{
  "database": "../.echo/structural-sample.sqlite",
  "collections": [
    {
      "id": "sample",
      "root": "./notes"
    }
  ],
  "chunker": {
    "module": "./structural-heading-chunker.mjs",
    "options": {
      "max_chars": 1000
    }
  },
  "retrieval": {
    "mode": "bm25",
    "topk": 10,
    "max_chunks_per_source": 3
  }
}
